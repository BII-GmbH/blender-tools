# Zugang zur Geo-Box für das Addon BII Umgebung.
# Als ".env" in den Ordner des Addons kopieren oder im Panel „Datenquelle“ unter
# „Zugangsdatei (.env)“ auswählen. Werte hier haben Vorrang vor den Feldern im Panel.
# Die .env.local der simbox hat dasselbe Format und funktioniert direkt.
SIMBOX_GEO_URL=https://geo.simbox.site
SIMBOX_GEO_TOKEN_URL=https://auth.bii-gmbh.com/realms/simbox/protocol/openid-connect/token
SIMBOX_GEO_CLIENT_ID=simbox-geo-dev
SIMBOX_GEO_CLIENT_SECRET=
